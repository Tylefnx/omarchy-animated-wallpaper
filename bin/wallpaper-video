#!/bin/bash
# Animated wallpaper engine. Implementation is split into small sourced modules.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/monitors.sh"
source "$SCRIPT_DIR/lib/processes.sh"
source "$SCRIPT_DIR/lib/actions.sh"

usage() {
  cat >&2 <<'EOF'
Usage: wallpaper-video <command> [args]
  status [--json]              Show monitor status
  start [monitor]              Start configured wallpapers
  stop [monitor]               Stop wallpapers started by this helper
  toggle                       Toggle all configured wallpapers
  set <monitor|all> <file>     Assign a video file (mp4, webm, mkv, avi, mov, gif)
  wallpaper <monitor>          Choose a static wallpaper for one monitor
  layout <monitor> <mode>      Set per-monitor scaling: fill, fit, stretch, center
  clear <monitor|all>          Clear an assignment
  pick [monitor]               Choose a video with zenity
  image [file]                 Choose or apply a static Omarchy background
  reconcile                    Stop video players after an Omarchy background change
EOF
  exit 1
}

status_json() {
  require_python
  python3 - "$MONITORS_DIR" "$PIDS_DIR" "$(wallpaper_mode)" "$LAYOUTS_DIR" <<'PY'
import json, os, subprocess, sys

monitors_dir, pids_dir, mode, layouts_dir = sys.argv[1:]
try:
    proc = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                          text=True, timeout=5, check=True)
    devices = json.loads(proc.stdout)
    if not isinstance(devices, list): devices = []
except (OSError, subprocess.SubprocessError, ValueError):
    devices = []

result = []
for device in devices:
    if not isinstance(device, dict): continue
    name = device.get("name") or ""
    if not isinstance(name, str) or not name or "/" in name or name in (".", "..") or "\n" in name: continue
    assignment = os.path.join(monitors_dir, name)
    video = ""
    try:
        if os.path.isfile(assignment) and not os.path.islink(assignment):
            with open(assignment, encoding="utf-8") as stream: video = stream.read().strip()
    except OSError: pass
    available = bool(video and os.path.isfile(video) and os.access(video, os.R_OK))
    layout = "fill"
    layout_path = os.path.join(layouts_dir, name)
    try:
        if (os.path.isdir(layouts_dir) and not os.path.islink(layouts_dir)
                and os.path.isfile(layout_path) and not os.path.islink(layout_path)):
            with open(layout_path, encoding="ascii") as stream:
                saved_layout = stream.read().strip()
            if saved_layout in ("fill", "fit", "stretch", "center"):
                layout = saved_layout
    except OSError: pass
    running = False
    pid_file = os.path.join(pids_dir, name + ".pid")
    try:
        if os.path.isfile(pid_file) and not os.path.islink(pid_file):
            with open(pid_file, encoding="ascii") as stream:
                fields = stream.read().split()
                pid, expected = int(fields[0]), fields[1]
            with open(f"/proc/{pid}/comm", encoding="ascii") as stream: comm = stream.read().strip()
            os.kill(pid, 0)
            with open(f"/proc/{pid}/stat", encoding="ascii") as stream:
                stat = stream.read()
            actual = stat[stat.rfind(")") + 2:].split()[19]
            running = comm == "mpvpaper" and actual == expected
    except (OSError, ValueError, IndexError, TypeError): pass
    result.append({"name": name, "description": device.get("description") or "",
                   "video": video, "videoName": os.path.basename(video) if video else "",
                   "available": available, "running": running, "layout": layout})
print(json.dumps({"monitors": result,
                  "active": sum(bool(m["running"]) for m in result),
                  "total": len(result), "mode": mode}))
PY
}

status_text() {
  require_python
  python3 - "$SCRIPT_DIR/wallpaper-video" <<'PY'
import json, subprocess, sys
script = sys.argv[1]
try:
    result = json.loads(subprocess.check_output([script, "status", "--json"], text=True))
except Exception:
    print("could not read wallpaper status"); raise SystemExit(1)
if not result["monitors"]: print("no monitors detected")
if result["mode"] == "image": print("global static wallpaper active")
elif result["mode"] == "off": print("wallpaper layers disabled")
for monitor in result["monitors"]:
    if monitor["running"]: state = "playing"
    elif monitor["video"] and not monitor["available"]: state = "missing wallpaper"
    elif monitor["video"]: state = "stopped"
    else: state = "no wallpaper"
    suffix = f" ({monitor['videoName']})" if monitor["videoName"] else ""
    print(f"{monitor['name']}: {state}{suffix}")
PY
}

[[ $# -gt 0 ]] || usage
command="$1"; shift
case "$command" in
  status)
    case "${1:-}" in "--json"|"") ;; *) usage ;; esac
    if [[ "${1:-}" == "--json" ]]; then status_json; else status_text; fi
    ;;
  start)
    [[ $# -le 1 ]] || usage
    if [[ "${1:-}" == "--restore" ]]; then
      reconcile_background
      [[ "$(wallpaper_mode)" == video ]] || exit 0
    else
      atomic_write "$MODE_FILE" video
      capture_background
    fi
    if [[ $# -eq 1 && "$1" != "--restore" ]]; then monitor_exists "$1" || die "unknown monitor '$1'"; start_monitor "$1"; else start_all; fi
    ;;
  stop)
    [[ $# -le 1 ]] || usage
    if [[ $# -eq 1 ]]; then
      monitor_is_known "$1" || die "unknown monitor '$1'"
      stop_monitor "$1"
    else stop_all; fi
    ;;
  toggle)
    [[ $# -eq 0 ]] || usage
    if any_running; then
      stop_all
    else
      atomic_write "$MODE_FILE" video
      capture_background
      start_all
    fi
    ;;
  set) [[ $# -eq 2 ]] || usage; set_video "$1" "$2" ;;
  layout) [[ $# -eq 2 ]] || usage; set_layout "$1" "$2" ;;
  clear) [[ $# -eq 1 ]] || usage; clear_video "$1" ;;
  pick) [[ $# -le 1 ]] || usage; pick_video "${1:-all}" ;;
  wallpaper) [[ $# -eq 1 ]] || usage; pick_wallpaper "$1" ;;
  image)
    [[ $# -le 1 ]] || usage
    if [[ $# -eq 1 ]]; then apply_image "$1"; else pick_image; fi
    ;;
  reconcile) [[ $# -eq 0 ]] || usage; reconcile_background ;;
  *) usage ;;
esac
