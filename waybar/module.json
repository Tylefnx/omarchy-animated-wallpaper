{
  "custom/wallpaper-video": {
    "exec": "$HOME/.local/bin/wallpaper-video status",
    "return-type": "json",
    "format": "󰕧 Wallpaper",
    "interval": "once",
    "signal": 11,
    "on-click": "$HOME/.local/bin/wallpaper-video toggle",
    "on-click-right": "$HOME/.local/bin/wallpaper-video pick",
    "tooltip": true
  }
}
