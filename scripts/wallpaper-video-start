#!/bin/bash
# Start configured animated wallpapers after the desktop comes up.
# Installed as a post-boot hook by install.sh.

HELPER="$HOME/.config/omarchy/plugins/r4venward.wallpaper-video/bin/wallpaper-video"
[[ -x "$HELPER" ]] || exit 0

# Let the compositor and its layer-shell surfaces settle first.
sleep 2

# Capture the report so it can be shown instead of being swallowed: an idle
# desktop (no videos assigned) is not an error, but an assigned video that
# will not play deserves a visible reason.
output=$("$HELPER" start --restore 2>&1)
status=$?

if ((status != 0)); then
  # The first line carries the headline — for start_all it already names the
  # monitors that failed — while the full multi-line report stays on stderr
  # for the journal. Flattening everything into one notification would turn
  # a useful reason into an unreadable wall of text.
  headline=${output%%$'\n'*}
  headline=${headline#wallpaper-video: }
  [[ -n "$headline" ]] || headline="Wallpaper could not start."
  printf 'wallpaper-video: %s\n' "$output" >&2
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "Animated wallpaper" "$headline" --urgency=critical 2>/dev/null || true
fi

# Always exit 0: omarchy-hook reports "Hook failed: <path>" for any non-zero
# result, and there is nothing further for it to act on at boot.
exit 0
